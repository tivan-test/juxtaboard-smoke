# Скопируйте этот файл в .env и заполните. .env не попадает ни в git, ни в Docker-образ.

# Адрес сайта, на котором идут тесты (рабочий сайт). Используется как baseURL в playwright.config.ts.
BASE_URL=https://juxtaboard.com

# Почта учётной записи Juxtaboard для входа (tests/setup/auth.setup.ts и SM-01).
JB_EMAIL=

# Пароль этой учётной записи. Никогда не коммитьте и не пересылайте.
JB_PASSWORD=

# Ключ доступа к Juxtaboard API — нужен только для публикации (--publish): статусы в таблицы и документ в журнал.
# Без --publish не используется. Никогда не коммитьте и не пересылайте.
JUXT_TOKEN=
